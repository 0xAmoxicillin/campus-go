{
  "name": "campus-go",
  "version": "0.1.0",
  "private": true,
  "description": "校园行 CampusGo · monorepo 根工作区（M2 全栈/测试：真实服务 E2E / CI 门禁 / README / 离线产品演示）",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "lint": "pnpm -r run --if-present lint",
    "typecheck": "pnpm -r run --if-present typecheck",
    "test": "pnpm -r run --if-present test",
    "build": "pnpm -r run --if-present build",
    "test:e2e": "pnpm run test:e2e:contract",
    "test:e2e:contract": "playwright test --config scripts/e2e/playwright.config.ts",
    "test:e2e:real": "E2E_MODE=real playwright test --config scripts/e2e/playwright.real.config.ts",
    "check:versions": "bash scripts/check-version-consistency.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.9",
    "typescript": "5.9.2"
  }
}
