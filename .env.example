# ---- 通用 ----
NODE_ENV=development
# ---- 后端 / 数据库 ----
DATABASE_URL=postgresql://campusgo:campusgo@localhost:5432/campusgo?schema=public
POSTGRES_USER=campusgo
POSTGRES_PASSWORD=campusgo
POSTGRES_DB=campusgo
# ---- 鉴权（开发环境占位，部署时必须替换；勿提交真实密钥）----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# ---- 端口 ----
SERVER_PORT=3001
WEB_PORT=5173
# ---- 前端 ----
VITE_API_BASE_URL=http://localhost:3001/api
# ---- 初始管理员（仅种子脚本使用，不开放注册）----
ADMIN_SEED_EMAIL=admin@campusgo.local
ADMIN_SEED_PASSWORD=change-me-admin-password
