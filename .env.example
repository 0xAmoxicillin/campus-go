# ---- 通用 ----
NODE_ENV=development
# ---- 后端 / 数据库 ----
DATABASE_URL=postgresql://campusgo:CHANGE_ME@localhost:5432/campusgo?schema=public
POSTGRES_USER=campusgo
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=campusgo
# ---- 鉴权（部署前必须替换为强随机值；切勿提交真实密钥）----
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# ---- 端口 ----
SERVER_PORT=3001
WEB_PORT=5173
# ---- 前端 ----
VITE_API_BASE_URL=http://localhost:3001/api
# ---- 初始管理员（仅服务端种子脚本使用，不开放注册；部署前改掉）----
ADMIN_SEED_EMAIL=admin@campusgo.local
ADMIN_SEED_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
